[auto-move-windows]
application-list=['kitty.desktop:1', 'chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default.desktop:9', 'telegram-desktop_telegram-desktop.desktop:9', 'chrome-fmpnliohjhemenmnlpbfagaolkdacoja-Default.desktop:3', 'steam.desktop:5', 'chrome-mibgiapfolionpapiffjmagepkdbmdjn-Default.desktop:4', 'discord.desktop:8', 'brave-browser.desktop:2', 'thunderbird_thunderbird.desktop:10']

[clipboard-history]
private-mode=false

[dash-to-dock]
apply-custom-theme=false
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=43
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
hot-keys=false
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
preview-size-scale=0.0

[ding]
check-x11wayland=true
show-trash=false
show-volumes=true

[emoji-copy]
recently-used=['😂', '❤️', '😍', '😭', '😊', '😒', '😘', '😩', '🤔', '☺️', '👌']

[just-perfection]
animation=0
clock-menu-position=0
overlay-key=false
startup-status=0
support-notifier-showed-version=36
theme=false
workspace-popup=false

[pop-shell]
active-hint=true
gap-inner=uint32 3
gap-outer=uint32 3
hint-color-rgba='rgb(128,108,251)'
tile-by-default=true

[search-light]
animation-speed=100.0
blur-brightness=0.59999999999999998
blur-sigma=30.0
entry-font-size=1
monitor-count=3
preferred-monitor=0
scale-height=0.10000000000000001
scale-width=0.10000000000000001
shortcut-search=['<Super>backslash']

[tiling-assistant]
active-window-hint-color='rgb(211,70,21)'
last-version-installed=46
tiling-popup-all-workspace=true
